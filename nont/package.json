{
  "name": "nont",
  "version": "1.0.0",
  "description": "music downloader",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron": "^28.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "ytdl-core": "^4.11.5",
    "@ffmpeg/ffmpeg": "^0.12.2",
    "@ffmpeg/core": "^0.12.2",
    "axios": "^1.6.2",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "electron-builder": "^24.6.3",
    "vite": "^5.0.6",
    "vite-plugin-electron": "^0.15.2",
    "vite-plugin-electron-renderer": "^0.14.5",
    "concurrently": "^8.2.2"
  },
  "build": {
    "appId": "com.nont.app",
    "productName": "nont",
    "files": ["dist/**/*", "public/**/*"],
    "directories": {"output": "release"},
    "win": {"target": "nsis"},
    "mac": {"target": "dmg"},
    "linux": {"target": "AppImage"}
  }
}